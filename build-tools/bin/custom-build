#!/bin/bash
set -o errexit
set -o pipefail

brazil_build_target=$1

echo "Cleaning previous artifacts"
rm -rf build/opensearch-dashboards-core

echo "Copy OSD Core source code to build folder"
mkdir -p build/opensearch-dashboards-core
rsync -arvL . build/opensearch-dashboards-core --exclude=".git" --exclude="/plugins" --exclude="node_modules" --exclude="/build"

# TODO We do not have a auxillary build farm setup so for the time being, only local builds will run container-build
# See: https://w.amazon.com/bin/view/ContainerBuild/AuxiliaryBuildFarm
if [ "$brazil_build_target" != "release" ]; then
    # TODO We do not run unit tests as there are thousands of tests to cover in OSD core
    exec container-build  \
        --build-as-current-user=true \
        --build-command="yarn osd bootstrap --allow-root" \
        --image-dir="configuration" "$@"
fi